<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block cleartext (HTTP) traffic by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Supabase and other HTTPS services: explicit trust anchors to avoid
         hostname-aware checkServerTrusted issues with domain-config present -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">supabase.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Allow cleartext only for the backend server during development -->
    <!-- TODO: Remove this exception once backend supports HTTPS -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">144.24.154.69</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>